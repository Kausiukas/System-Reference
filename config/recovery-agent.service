[Unit]
Description=Process Recovery Agent for Automated Task Continuation
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/workspace
ExecStart=/usr/bin/python3 /workspace/src/recovery/process_recovery_agent.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables
Environment=PYTHONPATH=/workspace
Environment=WORKSPACE_ROOT=/workspace

# Resource limits
MemoryLimit=512M
CPUQuota=50%

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/workspace

[Install]
WantedBy=multi-user.target